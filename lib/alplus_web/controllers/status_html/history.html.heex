<Layouts.app flash={@flash} variant={:bare}>
  <.public_page_masthead
    public_page={@snapshot.public_page}
    postdeploy_owned?={@snapshot.public_page.vendor?}
    active={:status}
    status_path={~p"/status/#{@snapshot.public_page.public_slug}"}
    changelog_path={public_changelog_path(@snapshot)}
  >
    <:trailing>
      <a href={~p"/status/#{@snapshot.public_page.public_slug}"} class={public_action_class()}>
        <.icon name="hero-arrow-left" class="size-3.5 shrink-0" /> Current status
      </a>
    </:trailing>
  </.public_page_masthead>

  <main
    id="public-status-history"
    data-public-shell
    data-status-timezone-root
    data-refresh-seconds="30"
  >
    <section
      id="status-history-summary"
      aria-labelledby="status-history-heading"
      class="px-5 pb-8 pt-8 sm:px-11 sm:pt-10"
    >
      <div class="mx-auto flex max-w-content flex-col gap-3">
        <.status_badge
          tone={state_class(@snapshot.status)}
          label={status_word(@snapshot.status)}
          size={:public}
          class="w-fit"
        />
        <h1
          id="status-history-heading"
          class="text-heading-01 font-semibold tracking-[-0.02em] text-text-primary"
        >
          90-day service history
        </h1>
        <p class="text-pretty text-body text-text-secondary">
          Uptime, resolved incidents, announcements, and maintenance for {@snapshot.public_page.title}. Every uptime figure names the days it was observed on.
        </p>
      </div>
    </section>

    <section
      id="status-uptime"
      aria-labelledby="status-uptime-heading"
      class="border-t border-border-subtle px-5 py-8 sm:px-11"
    >
      <div class="mx-auto flex max-w-content flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <h2
            id="status-uptime-heading"
            class="text-heading-02 font-semibold tracking-[-0.01em] text-text-primary"
          >
            Uptime
          </h2>
          <p class="text-pretty text-body text-text-secondary">
            One square per day. Grey squares are days with no checks, not downtime.
          </p>
        </div>
        <div class="min-w-0 divide-y divide-border-subtle overflow-hidden rounded-frame border border-border-public bg-surface-raised">
          <.service_row
            :for={service <- @snapshot.services}
            id={"status-history-service-#{service.id}"}
            service={service}
          />
          <p
            :if={@snapshot.services == []}
            class="px-5 py-6 text-body text-text-secondary"
          >
            No services are published on this page yet.
          </p>
        </div>
      </div>
    </section>

    <div id="status-history">
      <section
        id="status-incident-history"
        aria-labelledby="status-incident-history-heading"
        class="border-t border-border-subtle bg-canvas px-5 py-8 sm:px-11"
      >
        <div class="mx-auto flex max-w-content flex-col gap-4">
          <h2
            id="status-incident-history-heading"
            class="text-heading-02 font-semibold tracking-[-0.01em] text-text-primary"
          >
            Resolved incidents
          </h2>
          <p
            :if={incident_history_months(@snapshot) == []}
            class="text-body text-text-secondary"
          >
            No incidents were resolved in this period.
          </p>
          <div
            :for={{month, incidents} <- incident_history_months(@snapshot)}
            class="flex min-w-0 flex-col gap-3"
          >
            <p class="font-mono text-data font-semibold text-text-tertiary">{month}</p>
            <div class="min-w-0 divide-y divide-border-subtle overflow-hidden rounded-frame border border-border-public bg-surface-raised">
              <article
                :for={incident <- incidents}
                id={"status-incident-history-#{incident.id}"}
                class="min-w-0 px-5 py-5"
              >
                <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5">
                  <h3 class="min-w-0 break-words font-public text-label font-semibold text-text-primary">
                    {incident.title}
                  </h3>
                  <.status_badge tone="success" label="Resolved" size={:public} />
                </div>
                <ol class="mt-3 space-y-4 border-l border-border-public pl-4">
                  <li :for={entry <- incident_timeline(incident)}>
                    <p class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
                      <span class="text-label font-semibold text-text-secondary">
                        {update_kind_label(entry.kind)}
                      </span>
                      <.status_time
                        at={entry.inserted_at}
                        class="font-mono text-data tabular-nums text-text-tertiary"
                      />
                    </p>
                    <p class="mt-1.5 whitespace-pre-line break-words text-body text-text-secondary">
                      {entry.body}
                    </p>
                  </li>
                </ol>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section
        id="status-announcement-history"
        aria-labelledby="status-announcement-history-heading"
        class="border-t border-border-subtle px-5 py-8 sm:px-11"
      >
        <div class="mx-auto flex max-w-content flex-col gap-4">
          <h2
            id="status-announcement-history-heading"
            class="text-heading-02 font-semibold tracking-[-0.01em] text-text-primary"
          >
            Announcements
          </h2>
          <p :if={@snapshot.announcement_history == []} class="text-body text-text-secondary">
            No announcements were published in this period.
          </p>
          <div
            :if={@snapshot.announcement_history != []}
            class="min-w-0 divide-y divide-border-subtle overflow-hidden rounded-frame border border-border-public bg-surface-raised"
          >
            <article
              :for={announcement <- @snapshot.announcement_history}
              class="min-w-0 px-5 py-5"
            >
              <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5">
                <h3 class="min-w-0 break-words font-public text-label font-semibold text-text-primary">
                  {announcement.title}
                </h3>
                <.status_badge
                  tone="neutral"
                  label={if announcement.status == "expired", do: "Expired", else: "Published"}
                  size={:public}
                />
              </div>
              <p class="mt-2 whitespace-pre-line break-words text-body text-text-secondary">
                {announcement.body}
              </p>
              <p class="mt-2.5 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 font-mono text-data tabular-nums text-text-tertiary">
                <span>Published</span>
                <.status_time at={announcement.published_at} class="font-mono tabular-nums" />
                <span
                  :if={announcement.expires_at}
                  class="flex flex-wrap items-center gap-x-2 gap-y-1"
                >
                  <span>then expired</span>
                  <.status_time at={announcement.expires_at} class="font-mono tabular-nums" />
                </span>
              </p>
            </article>
          </div>
        </div>
      </section>

      <section
        id="status-maintenance-history"
        aria-labelledby="status-maintenance-history-heading"
        class="border-t border-border-subtle bg-canvas px-5 py-8 sm:px-11"
      >
        <div class="mx-auto flex max-w-content flex-col gap-4">
          <h2
            id="status-maintenance-history-heading"
            class="text-heading-02 font-semibold tracking-[-0.01em] text-text-primary"
          >
            Maintenance
          </h2>
          <p :if={@snapshot.maintenance_history == []} class="text-body text-text-secondary">
            No maintenance windows were scheduled in this period.
          </p>
          <div
            :if={@snapshot.maintenance_history != []}
            class="min-w-0 overflow-hidden rounded-frame border border-border-public bg-surface-raised"
          >
            <.maintenance_list maintenances={@snapshot.maintenance_history} />
          </div>
        </div>
      </section>
    </div>

    <footer class="border-t border-border-subtle px-5 py-8 sm:px-11">
      <div class="mx-auto flex max-w-content flex-wrap items-center gap-x-6 gap-y-3">
        <a href={~p"/status/#{@snapshot.public_page.public_slug}"} class={public_action_class()}>
          <.icon name="hero-arrow-left" class="size-3.5 shrink-0" /> Current status
        </a>
        <button
          id="status-timezone-toggle"
          type="button"
          data-status-timezone-toggle
          class={public_action_class()}
          aria-pressed="false"
        >
          Use UTC
        </button>
        <.public_attribution
          postdeploy_owned?={@snapshot.public_page.vendor?}
          class="sm:ml-auto"
        />
      </div>
    </footer>
  </main>
</Layouts.app>
