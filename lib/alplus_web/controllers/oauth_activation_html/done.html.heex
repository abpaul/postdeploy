<Layouts.auth
  flash={@flash}
  title={if @client_connected?, do: "Device connected", else: "Request cancelled"}
  width={:panel}
>
  <section
    aria-labelledby="device-activation-result-heading"
    class="mx-auto max-w-[480px] overflow-hidden rounded-frame border border-border-public bg-surface-page shadow-frame"
  >
    <div class="px-6 py-6">
      <h2 id="device-activation-result-heading" class="text-heading-03 text-text-primary">
        <span :if={@client_connected?}>Your agent is connected</span>
        <span :if={not @client_connected?}>Request cancelled</span>
      </h2>
      <p class="mt-2 text-body text-text-secondary">
        <span :if={@client_connected?}>
          Return to your client. It finishes connecting on its own.
        </span>
        <span :if={not @client_connected?}>
          Nothing was shared. Your client reports that you refused access.
        </span>
      </p>
    </div>
  </section>
</Layouts.auth>
