<Layouts.auth flash={@flash} title={"Connect #{@client_name}"} width={:panel}>
  <section
    aria-labelledby="oauth-consent-heading"
    class={[
      "overflow-hidden rounded-frame border border-border-public bg-surface-page shadow-frame",
      @organization_mode? && "mx-auto max-w-[560px]"
    ]}
  >
    <div class="flex items-center gap-3 border-b border-border-subtle px-5 py-4 sm:px-6">
      <span
        aria-hidden="true"
        class="flex size-10 shrink-0 items-center justify-center rounded-input bg-surface-inverse font-mono text-data text-text-inverse"
      >
        {client_initials(@client_name)}
      </span>
      <.icon name="hero-arrow-right" class="size-4 shrink-0 text-text-tertiary" />
      <.logo variant={:mark} size={:sm} label="PostDeploy" class="shrink-0" />
      <div class="min-w-0 grow">
        <h2 id="oauth-consent-heading" class="text-heading-03 break-words text-text-primary">
          {@client_name}
        </h2>
        <p class="mt-0.5 break-words text-caption text-text-secondary">
          <span :if={@organization_mode?}>{@client_host}</span>
          <span :if={not @organization_mode?}>
            From {@client_host}. Signed in as {@account_email}.
          </span>
        </p>
      </div>
    </div>

    <form id="oauth-authorization-form" action={@form_action} method="post">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

      <dl
        :if={@organization_mode?}
        id="oauth-organization-scope"
        class="grid gap-4 border-b border-border-subtle px-5 py-4 sm:grid-cols-2 sm:px-6"
      >
        <div>
          <dt class="text-label text-text-tertiary">Organization</dt>
          <dd class="mt-1 text-body font-semibold text-text-primary">{@organization.name}</dd>
          <dd class="mt-0.5 text-caption text-text-secondary">
            All current and future projects.
          </dd>
        </div>
        <div>
          <dt class="text-label text-text-tertiary">Account</dt>
          <dd class="mt-1 break-all text-body text-text-primary">{@account_email}</dd>
        </div>
      </dl>

      <div
        :if={not @organization_mode?}
        class="grid gap-4 border-b border-border-subtle px-6 py-5 sm:grid-cols-2"
      >
        <div>
          <label for="oauth-organization" class="mb-1.5 block text-label text-text-primary">
            Organization
          </label>
          <select
            id="oauth-organization"
            name="org_id"
            class="block h-control-md w-full rounded-input border border-border-control bg-surface-raised px-3 text-body text-text-primary"
          >
            <option :for={choice <- @choices} value={choice.organization.id}>
              {choice.organization.name}
            </option>
          </select>
        </div>

        <div>
          <label for="oauth-project" class="mb-1.5 block text-label text-text-primary">
            Project
          </label>
          <select
            id="oauth-project"
            name="project_id"
            class="block h-control-md w-full rounded-input border border-border-control bg-surface-raised px-3 text-body text-text-primary"
          >
            <optgroup :for={choice <- @choices} label={choice.organization.name}>
              <option
                :for={project <- choice.projects}
                value={project.id}
                data-org-id={choice.organization.id}
              >
                {project.name}
              </option>
            </optgroup>
          </select>
        </div>
      </div>

      <fieldset
        :if={@organization_mode?}
        aria-describedby={
          if @permission_error,
            do: "oauth-access-help oauth-permissions-error",
            else: "oauth-access-help"
        }
        class="border-b border-border-subtle px-5 py-4 sm:px-6"
      >
        <legend class="text-body font-semibold text-text-primary">Access level</legend>
        <p id="oauth-access-help" class="mt-1 text-caption text-text-secondary">
          Destructive actions always need your approval in PostDeploy.
        </p>
        <p
          :if={@permission_error}
          id="oauth-permissions-error"
          class="mt-2 text-label text-status-error-ink"
          role="alert"
        >
          {@permission_error}
        </p>
        <div class="mt-3 rounded-input bg-surface-sunken px-4">
          <label class="flex min-h-target-min cursor-pointer items-start gap-3 py-3">
            <input
              type="radio"
              name="access"
              value="read"
              checked
              class="mt-0.5 size-[15px] shrink-0 appearance-none rounded-dot border-[1.5px] border-border-control bg-surface-raised checked:border-[4.5px] checked:border-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
            />
            <span>
              <span class="block text-label font-semibold text-text-primary">Read only</span>
              <span class="mt-0.5 block text-caption text-text-secondary">
                View every project. Nothing changes.
              </span>
            </span>
          </label>
          <label
            :if={@read_write_available?}
            class="flex min-h-target-min cursor-pointer items-start gap-3 border-t border-border-subtle py-3"
          >
            <input
              type="radio"
              name="access"
              value="read_write"
              class="mt-0.5 size-[15px] shrink-0 appearance-none rounded-dot border-[1.5px] border-border-control bg-surface-raised checked:border-[4.5px] checked:border-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
            />
            <span>
              <span class="block text-label font-semibold text-text-primary">Read and write</span>
              <span class="mt-0.5 block text-caption text-text-secondary">
                View, create, change, and publish in every project.
              </span>
            </span>
          </label>
        </div>
      </fieldset>

      <fieldset
        :if={not @organization_mode?}
        aria-describedby={
          if @permission_error,
            do: "oauth-permissions-help oauth-permissions-error",
            else: "oauth-permissions-help"
        }
      >
        <legend class="sr-only">Permissions requested</legend>
        <div class="border-b border-border-subtle px-6 py-4">
          <h3 class="text-label font-bold text-text-primary">Permissions</h3>
          <p id="oauth-permissions-help" class="mt-1 text-caption text-text-secondary">
            Choose the permissions this client can use. Select at least one.
          </p>
          <p
            :if={@permission_error}
            id="oauth-permissions-error"
            class="mt-2 text-label text-status-error-ink"
            role="alert"
          >
            {@permission_error}
          </p>
        </div>
        <table class="w-full table-fixed border-collapse">
          <caption class="sr-only">Requested access by PostDeploy capability</caption>
          <thead>
            <tr class="border-b border-border-subtle text-label text-text-tertiary">
              <th scope="col" class="px-6 py-3 text-left font-semibold">Capability</th>
              <th scope="col" class="w-16 py-3 text-center font-semibold">Read</th>
              <th scope="col" class="w-16 py-3 text-center font-semibold">Write</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-subtle">
            <tr :for={group <- @scope_groups}>
              <th
                scope="row"
                class="px-6 py-3 text-left text-label font-semibold text-text-primary"
              >
                {group.label}
              </th>
              <td :for={option <- group.options} class="p-0 text-center">
                <label
                  :if={option}
                  for={"oauth-scope-#{option.id}"}
                  class="inline-flex size-11 cursor-pointer items-center justify-center"
                >
                  <span class="sr-only">{option.label}</span>
                  <input
                    id={"oauth-scope-#{option.id}"}
                    type="checkbox"
                    name="scope_indices[]"
                    value={option.id}
                    checked={option.checked}
                    class="peer grid size-[15px] shrink-0 appearance-none place-items-center rounded-[4px] border-[1.5px] border-border-control bg-surface-raised after:text-[10px] after:font-bold after:leading-none after:text-transparent after:content-['✓'] checked:border-transparent checked:bg-surface-inverse checked:after:text-interactive-primary"
                  />
                </label>
                <span
                  :if={is_nil(option)}
                  aria-hidden="true"
                  class="text-caption text-text-disabled"
                >
                  Not available
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </fieldset>

      <p
        :if={assigns[:unsolicited_warning]}
        class="border-t border-border-subtle bg-surface-sunken px-5 py-3 text-caption text-text-primary sm:px-6"
        role="note"
      >
        {@unsolicited_warning}
      </p>

      <div class="flex flex-col gap-3 border-t border-border-subtle px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p class="text-caption text-text-tertiary">
          {@return_note}
        </p>
        <div class="flex items-center justify-end gap-4">
          <.button type="submit" name="decision" value="deny" variant="ghost">
            Cancel
          </.button>
          <.button type="submit" name="decision" value="allow" variant="primary">
            Allow access
          </.button>
        </div>
      </div>

      <script nonce={assigns[:csp_nonce]}>
        (() => {
          const org = document.getElementById("oauth-organization")
          const project = document.getElementById("oauth-project")
          if (!org || !project) return

          const sync = () => {
            const orgId = org.value
            for (const option of project.querySelectorAll("option")) {
              option.hidden = option.dataset.orgId !== orgId
            }
            if (project.selectedOptions[0]?.hidden) {
              const first = [...project.options].find((option) => !option.hidden)
              if (first) project.value = first.value
            }
          }

          org.addEventListener("change", sync)
          sync()
        })()
      </script>
    </form>
  </section>
</Layouts.auth>
