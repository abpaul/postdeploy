<.topbar current_path="/docs" current_user={@current_user} />

<main id="docs-index" data-public-shell>
  <.resource_shell
    docs={docs_categories(@docs)}
    guide_groups={guide_groups(@guides)}
    current_path="/docs"
  >
    <.resource_masthead
      id="docs-masthead"
      breadcrumbs={[{"Home", ~p"/"}, {"Docs", ~p"/docs"}]}
      breadcrumbs_id="docs-breadcrumbs"
      title={@page.hero_heading}
      description={@page.hero_description}
    />

    <% {start, categories} =
      Enum.split_with(docs_categories(@docs), &(&1.key == "get-started")) %>

    <div id="docs-article">
      <section
        :for={category <- start}
        id="docs-start"
        class="mt-10 rounded-frame bg-surface-sunken p-6 sm:p-8"
        aria-labelledby="docs-start-heading"
      >
        <h2 id="docs-start-heading" class="text-heading-02 text-text-primary">Start here</h2>
        <p class="mt-2 max-w-[60ch] text-body-long text-text-secondary">{category.outcome}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <.button
            :for={page <- [category.root | category.topics]}
            href={page.path}
            variant="secondary"
          >
            {if page == category.root, do: page.hero_heading, else: page.nav_label}
            <.icon name="hero-arrow-right" class="size-4" />
          </.button>
        </div>
      </section>

      <div class="grid gap-x-12 gap-y-12 pt-12 md:grid-cols-2">
        <section
          :for={category <- categories}
          id={"docs-category-#{category.key}"}
          aria-labelledby={"docs-category-#{category.key}-heading"}
          class="min-w-0"
        >
          <h2
            id={"docs-category-#{category.key}-heading"}
            class="text-heading-02 text-text-primary"
          >
            <a
              href={category.root.path}
              class="underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-interactive-primary"
            >{category.title}</a>
          </h2>
          <p class="mt-1 text-body text-text-secondary">{category.outcome}</p>
          <ul class="mt-4 border-t border-border-default">
            <li
              :for={{page, index} <- Enum.with_index([category.root | category.topics])}
              class="border-b border-border-default"
            >
              <a
                href={page.path}
                class="group flex min-h-target-min items-center justify-between gap-3 py-2 text-body font-semibold text-text-primary transition-colors duration-productive hover:text-interactive-strong"
              >
                <span>{if index == 0, do: page.hero_heading, else: page.nav_label}</span>
                <.icon
                  name="hero-arrow-right"
                  class="size-4 shrink-0 text-text-tertiary transition-transform duration-productive group-hover:translate-x-0.5"
                />
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>

    <section class="pt-14" aria-labelledby="docs-explore-heading">
      <h2 id="docs-explore-heading" class="text-heading-02 text-text-primary">Explore further</h2>
      <ul class="mt-4 grid border-t border-border-default sm:grid-cols-2 sm:gap-x-12">
        <li class="border-b border-border-default">
          <a href={~p"/guides"} class="group block py-4">
            <span class="flex items-center justify-between gap-3 font-semibold text-text-primary group-hover:text-interactive-strong">
              Platform guides
              <.icon
                name="hero-arrow-right"
                class="size-4 shrink-0 text-text-tertiary transition-transform duration-productive group-hover:translate-x-0.5"
              />
            </span>
            <span class="mt-1 block text-body text-text-secondary">Follow a setup for the scheduler or tool you use.</span>
          </a>
        </li>
        <li class="border-b border-border-default">
          <a href={~p"/alternatives"} class="group block py-4">
            <span class="flex items-center justify-between gap-3 font-semibold text-text-primary group-hover:text-interactive-strong">
              Compare tools
              <.icon
                name="hero-arrow-right"
                class="size-4 shrink-0 text-text-tertiary transition-transform duration-productive group-hover:translate-x-0.5"
              />
            </span>
            <span class="mt-1 block text-body text-text-secondary">See how PostDeploy fits the tools you already use.</span>
          </a>
        </li>
      </ul>
    </section>
  </.resource_shell>

  <.final_cta
    current_user={@current_user}
    heading="Start with one project."
    body={"#{Alplus.Billing.Package.trial_days()} days free, no card required. Then #{AlplusWeb.Marketing.PackagePresenter.price()} a month."}
  />
</main>

<.site_footer />
