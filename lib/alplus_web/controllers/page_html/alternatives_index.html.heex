<.topbar current_path="/alternatives" current_user={@current_user} />

<main id="alternatives-index" data-public-shell>
  <.leadspace
    id="alternatives-leadspace"
    breadcrumbs={[{"Home", ~p"/"}, {"Alternatives", ~p"/alternatives"}]}
    breadcrumbs_id="alternatives-breadcrumbs"
    title={@page.hero_heading}
    description={@page.hero_description}
  >
    <:actions>
      <.button href={start_path(@current_user)} variant="primary">
        {AlplusWeb.Marketing.PackagePresenter.cta_label()}
      </.button>
    </:actions>
  </.leadspace>

  <div class="mx-auto max-w-content px-6 sm:px-11">
    <.article_layout id="alternatives-article" class="border-t-0 md:pt-4">
      <section :for={family <- comparison_families(@comparisons)} class="py-8 first:pt-0">
        <div class="max-w-[46rem]">
          <div class="mb-5">
            <h2 class="text-heading-02 text-text-primary">{family.heading}</h2>
            <p class="mt-3 max-w-prose text-body text-text-secondary">{family.blurb}</p>
          </div>
          <ul class="divide-y divide-border-default border-y border-border-default">
            <li :for={comparison <- family.items}>
              <.index_row
                id={"comparison-index-#{comparison.slug}"}
                title={comparison.competitor_name}
                description={comparison.summary || comparison.tldr}
                meta="Comparison"
                href={comparison.path}
              />
            </li>
          </ul>
        </div>
      </section>

      <section
        :if={@page.body_sections != []}
        id="alternatives-guidance"
        class="max-w-[46rem] border-t border-border-default py-8"
      >
        <.body_sections sections={@page.body_sections} variant="prose" />
      </section>

      <section
        :if={@page.faqs != []}
        id="alternatives-faq"
        class="max-w-[46rem] border-t border-border-default py-8"
      >
        <div class="max-w-[46rem]">
          <h2 class="text-heading-02 text-text-primary md:col-span-5">
            Before you switch
          </h2>
          <div class="mt-4 md:col-span-7"><.faq_list faqs={@page.faqs} /></div>
        </div>
      </section>
    </.article_layout>
  </div>
</main>

<.site_footer />
