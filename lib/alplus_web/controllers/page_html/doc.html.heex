<.topbar current_path={@guide.path} current_user={@current_user} />

<main id="doc-page" data-public-shell>
  <.resource_shell
    docs={docs_categories(@docs)}
    guide_groups={guide_groups(@guides)}
    current_path={@guide.path}
  >
    <article id="doc-article" class="max-w-[46rem]">
      <.resource_masthead
        id="doc-masthead"
        breadcrumbs={@breadcrumbs}
        breadcrumbs_id="doc-breadcrumbs"
        title={@guide.hero_heading}
        description={@guide.hero_description}
      >
        <:meta :if={@guide.code_verified_on || @guide.last_verified_on}>
          <span :if={@guide.code_verified_on}>Samples run on
          <time datetime={Date.to_iso8601(@guide.code_verified_on)}>{@guide.code_verified_on}</time></span><span :if={
            @guide.code_verified_on && @guide.last_verified_on
          }>, </span><span :if={@guide.last_verified_on}>facts checked on
          <time datetime={Date.to_iso8601(@guide.last_verified_on)}>{@guide.last_verified_on}</time></span>
        </:meta>
      </.resource_masthead>

      <.page_contents
        :if={length(@guide.body_sections) > 1}
        items={
          doc_contents(@guide.body_sections) ++
            if(@guide.not_offered != [], do: [{"Limits", "limits"}], else: [])
        }
      />

      <.doc_sections sections={@guide.body_sections} />

      <.article_section :if={@guide.not_offered != []} id="limits" title="Limits">
        <ul class="divide-y divide-border-default border-y border-border-default">
          <li :for={item <- @guide.not_offered} class="py-3 text-body-long text-text-secondary">
            <.rich_text text={item} />
          </li>
        </ul>
      </.article_section>

      <.article_section :if={@guide.related_paths != []} id="related" title="Related pages">
        <.related_links links={related_links(@guide.related_paths, "doc-related")} />
      </.article_section>
    </article>
  </.resource_shell>

  <.final_cta
    current_user={@current_user}
    heading={@guide.cta_heading || "Send your first signal today."}
    body={"#{Alplus.Billing.Package.trial_days()} days free, no card required. Then #{AlplusWeb.Marketing.PackagePresenter.price()} a month."}
    label={@guide.cta_label || AlplusWeb.Marketing.PackagePresenter.cta_label()}
  />
</main>

<.site_footer />
