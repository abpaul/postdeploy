<.topbar current_path="/docs/search" current_user={@current_user} />

<main id="resources-search" data-public-shell>
  <.resource_shell
    docs={docs_categories(@docs)}
    guide_groups={guide_groups(@guides)}
    current_path="/docs/search"
    query={@query}
  >
    <.resource_masthead
      id="search-masthead"
      breadcrumbs={[{"Home", ~p"/"}, {"Docs", ~p"/docs"}, {"Search", ~p"/docs/search"}]}
      title="Search Docs and Guides"
      description="Find setup instructions, platform guides, and product details."
    />

    <form
      id="resource-search-form"
      action={~p"/docs/search"}
      method="get"
      role="search"
      class="max-w-[46rem] py-8"
    >
      <label for="resource-search-query" class="block text-label font-semibold text-text-primary">Search terms</label>
      <div class="mt-2 flex gap-3">
        <input
          id="resource-search-query"
          type="search"
          name="q"
          value={@query}
          maxlength="120"
          class="h-target-min min-w-0 flex-1 rounded-input border border-border-control bg-surface-page px-4 text-body-long text-text-primary"
        />
        <.button type="submit" variant="secondary">Search</.button>
      </div>
    </form>

    <section :if={@query != ""} id="search-results" aria-live="polite" class="max-w-[46rem] pb-12">
      <h2 class="text-heading-02 text-text-primary">
        {length(@results)} {if length(@results) == 1, do: "result", else: "results"}
      </h2>
      <p :if={@results == []} class="mt-4 text-body-long text-text-secondary">
        No pages match this search. Try a product name, platform, or task.
      </p>
      <ul
        :if={@results != []}
        class="mt-4 divide-y divide-border-default border-y border-border-default"
      >
        <li :for={result <- @results}>
          <a href={result.path} class="group block py-4">
            <span class="text-caption font-semibold text-text-tertiary">{if result.kind == :docs,
              do: "Docs",
              else: "Guide"}</span>
            <span class="mt-1 flex items-center justify-between gap-3 font-semibold text-text-primary transition-colors duration-productive group-hover:text-interactive-strong">
              {result.title}
              <.icon
                name="hero-arrow-right"
                class="size-4 shrink-0 transition-transform duration-productive group-hover:translate-x-0.5"
              />
            </span>
            <span class="mt-2 block text-body text-text-secondary">{result.summary}</span>
          </a>
        </li>
      </ul>
    </section>
  </.resource_shell>
</main>

<.site_footer />
