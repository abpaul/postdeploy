<.topbar current_path="/pricing" current_user={@current_user} />

<main id="pricing-page" data-public-shell>
  <.leadspace
    id="pricing-leadspace"
    breadcrumbs={[{"Home", ~p"/"}, {"Pricing", ~p"/pricing"}]}
    breadcrumbs_id="pricing-breadcrumbs"
    title={@page.hero_heading}
    description={@page.hero_description}
  />

  <section id="pricing-offer" class="border-b border-border-public">
    <div class="mx-auto max-w-content px-6 py-10 sm:px-11 md:py-14">
      <.package_offer current_user={@current_user} />
    </div>
  </section>

  <section
    :if={@page.body_sections != []}
    id="pricing-setup"
    class="mx-auto max-w-content px-6 py-12 sm:px-11 md:py-16"
  >
    <.body_sections sections={@page.body_sections} />
  </section>

  <section
    id="pricing-features"
    class="mx-auto max-w-content border-t border-border-default px-6 py-12 sm:px-11 md:py-16"
  >
    <div class="grid gap-5 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <h2 class="text-heading-02 text-text-primary">Every tool is included</h2>
        <p class="mt-3 max-w-prose text-body-long text-text-secondary">
          No add-ons and no modules. Uptime, cron heartbeats, errors and analytics run on the same
          projects, under the same login.
        </p>
      </div>
      <div class="lg:col-span-7"><.package_features /></div>
    </div>
  </section>

  <section id="pricing-allowances" class="border-y border-border-default bg-surface-sunken">
    <div class="mx-auto max-w-content px-6 py-12 sm:px-11 md:py-16">
      <div class="grid gap-5 lg:grid-cols-12 lg:items-start lg:gap-10">
        <div class="lg:col-span-5">
          <h2 class="text-heading-02 text-text-primary">Every allowance PostDeploy enforces</h2>
          <p class="mt-3 max-w-prose text-body-long text-text-secondary">
            Monitors, cron jobs, events, projects, members and retention, in full. The trial grants
            every one of them.
          </p>
        </div>
        <div class="lg:col-span-7"><.included_list /></div>
      </div>
    </div>
  </section>

  <section id="pricing-terms" class="mx-auto max-w-content px-6 py-12 sm:px-11 md:py-16">
    <h2 class="text-heading-02 text-text-primary">Before you subscribe</h2>
    <p class="mt-3 max-w-prose text-body-long text-text-secondary">
      How the allowances behave when you reach them, and what PostDeploy does not do.
    </p>
    <div class="mt-8"><.package_terms /></div>
  </section>

  <div class="mx-auto max-w-content px-6 sm:px-11">
    <.article_layout id="pricing-article" class="border-t-0 md:pt-4">
      <section
        :if={@page.faqs != []}
        id="pricing-faq"
        class="mt-12 border-t border-border-default pt-8"
      >
        <div class="grid gap-5 lg:grid-cols-12 lg:items-start lg:gap-10">
          <h2 class="text-heading-02 text-text-primary lg:col-span-5">
            Pricing questions
          </h2>
          <div class="lg:col-span-7"><.faq_list faqs={@page.faqs} /></div>
        </div>
      </section>
    </.article_layout>
  </div>

  <.final_cta
    current_user={@current_user}
    heading="Try it on your own projects."
    body={"Every allowance, free for #{Alplus.Billing.Package.trial_days()} days. No credit card required."}
  />
</main>

<.site_footer />
