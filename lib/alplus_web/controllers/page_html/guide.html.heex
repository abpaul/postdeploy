<.topbar current_path={@guide.path} current_user={@current_user} />

<% {transcript, sections} = split_transcript(@guide.body_sections) %>

<main id="marketing-guide" data-public-shell>
  <.leadspace
    :if={transcript}
    id="guide-leadspace"
    breadcrumbs={@breadcrumbs}
    breadcrumbs_id="guide-breadcrumbs"
    title={@guide.hero_heading}
    description={@guide.hero_description}
    evidence_class="min-w-0"
  >
    <:actions>
      <.button href={start_path(@current_user)} variant="primary">
        {AlplusWeb.Marketing.PackagePresenter.cta_label()}
      </.button>
      <span class="text-caption text-text-tertiary">
        No card required. Then {AlplusWeb.Marketing.PackagePresenter.price()} a month.
      </span>
    </:actions>
    <:evidence>
      <.setup_transcript id="guide-transcript" transcript={transcript} />
    </:evidence>
  </.leadspace>

  <div class="mx-auto max-w-content px-6 py-8 sm:px-11 lg:py-10">
    <article id="guide-article" class="max-w-[46rem]">
      <.resource_masthead
        :if={!transcript}
        id="guide-leadspace"
        breadcrumbs={@breadcrumbs}
        breadcrumbs_id="guide-breadcrumbs"
        title={@guide.hero_heading}
        description={@guide.hero_description}
      >
        <:meta :if={@guide.author_name || @guide.published_on || @guide.last_verified_on}>
          <.article_byline guide={@guide} />
        </:meta>
        <:actions :if={@guide.path not in ["/about", "/privacy", "/terms"]}>
          <.button href={start_path(@current_user)} variant="primary">
            {AlplusWeb.Marketing.PackagePresenter.cta_label()}
          </.button>
          <span class="text-caption text-text-tertiary">
            No card required. Then {AlplusWeb.Marketing.PackagePresenter.price()} a month.
          </span>
        </:actions>
      </.resource_masthead>

      <div class={!transcript && "pt-10"}>
        <.body_sections sections={sections} variant="prose" />
      </div>

      <.article_section :if={@guide.faqs != []} id="guide-faq" title="Questions">
        <.faq_list faqs={@guide.faqs} />
      </.article_section>

      <.article_section
        :if={@guide.not_offered != []}
        id="guide-not-offered"
        title="What PostDeploy does not do here"
      >
        <ul class="divide-y divide-border-default border-y border-border-default">
          <li :for={item <- @guide.not_offered} class="py-3 text-body-long text-text-secondary">
            {item}
          </li>
        </ul>
      </.article_section>

      <.article_section :if={@guide.sources != []} id="guide-sources" title="Sources">
        <.source_list sources={@guide.sources} />
      </.article_section>

      <.article_section
        :if={@guide.related_paths != [] || @guide.related_guide_path}
        id="guide-related"
        title="Related pages"
      >
        <.related_links links={
          related_links(@guide.related_paths, "guide-related") ++
            if(@guide.related_paths == [] && @guide.related_guide_path,
              do: [
                %{
                  id: "guide-related-guide",
                  label: "Read the related guide",
                  path: @guide.related_guide_path
                }
              ],
              else: []
            ) ++
            if(Enum.any?(@guide.related_paths || [], &(&1["path"] == "/pricing")),
              do: [],
              else: [%{id: "guide-related-pricing", label: "Pricing", path: ~p"/pricing"}]
            )
        } />
      </.article_section>
    </article>
  </div>

  <.final_cta
    :if={!transcript}
    current_user={@current_user}
    heading={@guide.cta_heading || "Try PostDeploy on the project you already run."}
    body={"#{Alplus.Billing.Package.trial_days()} days free, no card required. Then #{AlplusWeb.Marketing.PackagePresenter.price()} a month."}
    label={AlplusWeb.Marketing.PackagePresenter.cta_label()}
  />
</main>

<.site_footer />
