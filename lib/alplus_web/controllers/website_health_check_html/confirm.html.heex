<.topbar current_path="/tools/website-health-check" current_user={@current_user} />

<main id="website-health-check-confirm" data-public-shell>
  <.leadspace
    id="health-check-confirm-leadspace"
    title="Create this monitor"
    description={"PostDeploy will check this URL on a schedule in #{@org.name}."}
  />

  <div class="mx-auto max-w-content px-6 py-10 sm:px-11 md:py-14">
    <section
      id="health-check-draft"
      class="max-w-measure rounded-frame border border-border-public bg-surface-raised p-5 sm:p-6"
      aria-labelledby="health-check-draft-heading"
    >
      <h2 id="health-check-draft-heading" class="text-heading-03 text-text-primary">
        What PostDeploy will watch
      </h2>
      <dl class="mt-4 divide-y divide-border-default border-t border-border-default">
        <div class="grid gap-1.5 py-4 sm:grid-cols-[6rem_minmax(0,1fr)] sm:gap-6">
          <dt class="text-label text-text-secondary">URL</dt>
          <dd class="font-mono text-data break-all text-text-primary">{@draft.url}</dd>
        </div>
        <div
          :if={@draft.keyword}
          class="grid gap-1.5 py-4 sm:grid-cols-[6rem_minmax(0,1fr)] sm:gap-6"
        >
          <dt class="text-label text-text-secondary">Keyword</dt>
          <dd class="text-body text-text-primary">{@draft.keyword}</dd>
        </div>
      </dl>
      <form
        id="health-check-confirm-form"
        action={~p"/tools/website-health-check/continue"}
        method="post"
        class="mt-6"
      >
        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
        <.button
          type="submit"
          variant="primary"
          id="health-check-confirm"
          class="w-full sm:w-auto"
          data-pending-submit
          data-pending-label="Creating the monitor"
        >
          <span data-pending-text>Create monitor</span>
          <.icon
            name="hero-arrow-path"
            class="size-4 motion-safe:animate-spin"
            data-pending-spinner
            hidden
          />
        </.button>
      </form>
      <p class="mt-3 text-caption text-text-tertiary">
        PostDeploy runs the first check as soon as the monitor exists.
      </p>
    </section>
  </div>
</main>

<.site_footer />
