<.topbar :if={@first_party?} current_path="/changelog" current_user={assigns[:current_user]} />

<.public_page_masthead
  :if={!@first_party?}
  public_page={@public_page}
  postdeploy_owned?={@postdeploy_owned?}
  header_id="changelog-header"
  active={:changelog}
  status_path={@status_path}
  changelog_path={@changelog_path}
/>

<main id="public-changelog-entry" data-public-shell>
  <.changelog_entry_body
    first_party?={@first_party?}
    postdeploy_owned?={@postdeploy_owned?}
    changelog={@changelog}
    entry={@entry}
    changelog_path={@changelog_path}
    rss_path={@rss_path}
    json_path={@json_path}
  />
</main>

<.site_footer :if={@first_party?} />
