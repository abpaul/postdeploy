<.topbar current_path="/blog" current_user={@current_user} />
<main id="blog-index" data-public-shell>
  <div class="mx-auto max-w-content px-6 py-12 sm:px-11 lg:py-16">
    <header class="border-b border-border-default pb-8">
      <h1 class="text-heading-01 text-text-primary">PostDeploy blog</h1>
      <p class="mt-4 max-w-[65ch] text-body-long text-text-secondary">
        Practical guidance for uptime, cron jobs, errors, analytics, and observability.
      </p>
      <p class="mt-4 text-caption text-text-tertiary">
        <a href="/blog/feed.xml">RSS</a>, <a href="/blog/posts.json">JSON</a>
      </p>
    </header>
    <div class="mt-8 divide-y divide-border-default border-y border-border-default">
      <p :if={@articles == []} class="py-5 text-body-long text-text-secondary">
        No articles published yet.
      </p>
      <a
        :for={article <- @articles}
        href={"/blog/#{article.slug}"}
        class="block py-5 hover:bg-interactive-wash"
      >
        <time
          class="text-caption text-text-tertiary"
          datetime={DateTime.to_iso8601(article.published_at)}
        >{Date.to_string(DateTime.to_date(article.published_at))}</time>
        <h2 class="mt-2 text-heading-03 text-text-primary">{article.title}</h2>
        <p class="mt-1 text-body text-text-secondary">{article.description}</p>
      </a>
    </div>
  </div>
</main>
<.site_footer />
