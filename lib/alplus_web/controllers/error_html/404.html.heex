<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | PostDeploy</title>
    <meta name="description" content="This page does not exist on postdeploy.dev." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" href={~p"/favicon.ico"} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/apple-touch-icon.png"} />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script nonce={assigns[:csp_nonce]}>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", localStorage.getItem("phx:theme") || "light");
      })();
    </script>
  </head>
  <body class="bg-surface-page font-sans text-body text-text-primary antialiased">
    <main
      id="not-found-page"
      data-public-shell
      class="flex min-h-dvh flex-col items-center justify-center px-4 py-16"
    >
      <div class="w-full max-w-measure text-center">
        <.logo variant={:mark} size={:lg} label="PostDeploy" href={~p"/"} class="mx-auto w-fit" />
        <p class="mt-8 font-mono text-eyebrow uppercase tracking-wide text-text-tertiary">404</p>
        <h1 class="mt-3 font-display text-heading-01 text-text-primary">
          This page took a detour.
        </h1>
        <p class="mt-3 text-body-long text-text-secondary">
          The link may be broken, or the page may have moved.
        </p>
        <.button navigate={~p"/"} variant="primary" class="mt-7">
          Go to homepage
        </.button>
        <nav aria-label="More pages" class="mt-10 border-t border-border-public pt-6">
          <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-data">
            <li :for={{label, path} <- header_links()}>
              <a class="text-text-tertiary hover:text-text-primary" href={path}>{label}</a>
            </li>
          </ul>
        </nav>
      </div>
    </main>
  </body>
</html>
