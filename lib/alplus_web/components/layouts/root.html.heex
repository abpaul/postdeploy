<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" href={~p"/favicon.ico"} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/apple-touch-icon.png"} />
    <.live_title default="PostDeploy" suffix="" phx-no-format>{assigns[:page_title]}</.live_title>
    <meta :if={assigns[:meta_description]} name="description" content={@meta_description} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={@canonical_url} />
    <meta :if={assigns[:robots]} name="robots" content={@robots} />
    <%!-- Public status pages set this so an open tab keeps showing new
          incident updates without JS. --%>
    <meta :if={assigns[:refresh_seconds]} http-equiv="refresh" content={@refresh_seconds} />
    <%!-- Search Console / Bing verification, only when configured. DNS TXT
          verification is preferred; these cover the meta-tag method. --%>
    <meta
      :if={Application.get_env(:alplus, :google_site_verification)}
      name="google-site-verification"
      content={Application.get_env(:alplus, :google_site_verification)}
    />
    <meta
      :if={Application.get_env(:alplus, :bing_site_verification)}
      name="msvalidate.01"
      content={Application.get_env(:alplus, :bing_site_verification)}
    />
    <%!-- Orynth (orynth.dev) listing verification. The token is public and fixed. --%>
    <meta name="ory-verify" content="orynth-a27e4df5908a4f06b3ec567fd193d84a" />
    <%= if assigns[:og_title] do %>
      <meta property="og:site_name" content="PostDeploy" />
      <meta property="og:type" content={assigns[:og_type] || "website"} />
      <meta property="og:title" content={@og_title} />
      <meta property="og:description" content={@og_description} />
      <meta property="og:url" content={assigns[:canonical_url]} />
      <meta
        :if={assigns[:article_published_time]}
        property="article:published_time"
        content={@article_published_time}
      />
      <%!-- One static preview for every page. Absolute URL: relative paths
            are not resolved by most social crawlers. --%>
      <meta property="og:image" content={AlplusWeb.Marketing.Seo.og_image_url()} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta
        property="og:image:alt"
        content="PostDeploy: everything your software needs after deployment."
      />
      <%!-- summary_large_image needs an image; without one X falls back to
            a bare text card. --%>
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={@og_title} />
      <meta name="twitter:description" content={@og_description} />
      <meta name="twitter:image" content={AlplusWeb.Marketing.Seo.og_image_url()} />
    <% end %>
    {json_ld_scripts(%{graphs: assigns[:json_ld] || []})}
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- `app.js` is the LiveView + Phoenix socket bundle (~147 KB minified,
          ~46 KB gzipped). The console needs it; the marketing controller
          pages do not, because they are server rendered and use no phx-*
          bindings at all. `AlplusWeb.Marketing.Seo.assign_seo/2` sets
          `:static_page`, so such a page opts out by being marketing rather
          than by remembering to opt out. The homepage (`AlplusWeb.HomeLive`)
          is the one marketing page that does need the bundle, so it sets
          `:marketing_page` without `:static_page`. The theme script below is
          inline and always runs. --%>
    <script
      :if={!assigns[:static_page]}
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/app.js"}
    >
    </script>
    <%!-- Dogfooding is independent from SEO eligibility. Customer-owned public
          pages use the marketing layout and metadata, but never PostDeploy's
          first-party Measure source. --%>
    <.measure_script marketing?={!!assigns[:measure_self_tracking]} />
    <script nonce={assigns[:csp_nonce]}>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          // Default to light. Users can still pick system/dark via the theme
          // toggle; only the no-preference default changed (was "system").
          setTheme(localStorage.getItem("phx:theme") || "light");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        // Delegated so the toggle works on dead-rendered pages too. Marketing,
        // status, and changelog pages ship no LiveView, so a phx-click binding
        // on these buttons is never processed and the toggle does nothing.
        document.addEventListener("click", (e) => {
          const button = e.target.closest("[data-phx-theme]");
          if (button) setTheme(button.dataset.phxTheme);
        });

        const copyText = (text) => {
          const fallback = () => {
            const textarea = document.createElement("textarea");
            textarea.value = text;
            textarea.setAttribute("readonly", "");
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";
            document.body.appendChild(textarea);
            textarea.select();

            try {
              if (!document.execCommand("copy")) throw new Error("Copy command rejected");
            } finally {
              textarea.remove();
            }
          };

          if (navigator.clipboard && typeof navigator.clipboard.writeText === "function") {
            return navigator.clipboard.writeText(text).catch(() => fallback());
          }

          return Promise.resolve(fallback());
        };

        // Controller pages do not load LiveView. Delegate their copy controls
        // here and leave LiveView-owned controls to their colocated hook.
        document.addEventListener("click", async (e) => {
          const button = e.target.closest("button[data-copy-fallback][data-target]");
          if (!button || button.closest("[data-phx-session]")) return;

          const target = document.getElementById(button.dataset.target);
          const label = button.querySelector("[data-copy-label]");
          if (!target || !label) return;

          const original = label.textContent;

          try {
            await copyText(target.innerText || target.textContent || "");
            label.textContent = "Copied";
          } catch (_error) {
            label.textContent = "Copy failed";
          }

          window.clearTimeout(button.__copyRestoreTimer);
          button.__copyRestoreTimer = window.setTimeout(() => {
            label.textContent = original;
          }, 1500);
        });

        // A server-rendered form whose action runs a live network request (the
        // website health check waits up to 10 seconds) otherwise shows nothing
        // between the click and the next page. Delegated, because these pages
        // ship no LiveView bundle.
        document.addEventListener("submit", (e) => {
          const form = e.target;
          if (!(form instanceof HTMLFormElement)) return;

          const button = form.querySelector("[data-pending-submit][data-pending-label]");
          if (!button || button.dataset.pending === "true") return;

          const label = button.querySelector("[data-pending-text]") || button;
          const spinner = button.querySelector("[data-pending-spinner]");
          button.dataset.pending = "true";
          button.dataset.idleLabel = label.textContent;
          label.textContent = button.dataset.pendingLabel;
          button.setAttribute("aria-busy", "true");
          if (spinner) spinner.hidden = false;
          // The form is already submitting, and the server reads no value from
          // this control, so disabling it only blocks a second request.
          button.disabled = true;
        });

        // A restored history entry keeps the DOM it was cached with, so the
        // button has to come back out of its pending state.
        window.addEventListener("pageshow", () => {
          document.querySelectorAll("[data-pending-submit][data-pending]").forEach((button) => {
            const label = button.querySelector("[data-pending-text]") || button;
            const spinner = button.querySelector("[data-pending-spinner]");
            if (button.dataset.idleLabel) label.textContent = button.dataset.idleLabel;
            if (spinner) spinner.hidden = true;
            delete button.dataset.pending;
            button.removeAttribute("aria-busy");
            button.disabled = false;
          });
        });

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });

        const mountMarketingDisclosure = () => {
          document.querySelectorAll("[data-marketing-menu]").forEach((root) => {
            if (root.dataset.marketingMounted) return;
            root.dataset.marketingMounted = "true";

            const button = root.querySelector("[data-marketing-menu-button]");
            const panel = root.querySelector("[data-marketing-menu-panel]");
            if (!button || !panel) return;

            let open = false;
            const close = () => {
              open = false;
              button.setAttribute("aria-expanded", "false");
              panel.hidden = true;
              document.documentElement.removeAttribute("data-marketing-menu-open");
              button.focus({preventScroll: true});
            };
            const show = () => {
              open = true;
              button.setAttribute("aria-expanded", "true");
              panel.hidden = false;
              document.documentElement.setAttribute("data-marketing-menu-open", "");
              const first = panel.querySelector("a, button");
              if (first) first.focus({preventScroll: true});
            };

            button.addEventListener("click", () => (open ? close() : show()));
            panel.querySelectorAll("a, button").forEach((item) => {
              item.addEventListener("click", () => close());
            });
            panel.addEventListener("keydown", (event) => {
              if (event.key !== "Tab") return;

              const focusable = Array.from(panel.querySelectorAll("a, button")).filter((item) => {
                return !item.disabled && !item.hasAttribute("hidden") && item.offsetParent !== null;
              });
              if (!focusable.length) return;

              const first = focusable[0];
              const last = focusable[focusable.length - 1];
              if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
              } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
              }
            });
            document.addEventListener("pointerdown", (event) => {
              if (open && !root.contains(event.target)) close();
            });
            document.addEventListener("keydown", (event) => {
              if (open && event.key === "Escape") {
                event.preventDefault();
                close();
              }
            });
          });
        };

        const mountMarketingTabs = () => {
          document.querySelectorAll("[data-marketing-tablist]").forEach((tablist) => {
            if (tablist.dataset.marketingMounted) return;
            tablist.dataset.marketingMounted = "true";

            const scope = tablist.closest("[data-marketing-tabs-scope]") || tablist.parentElement;
            const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
            const panels = scope ? Array.from(scope.querySelectorAll('[role="tabpanel"]')) : [];
            if (!tabs.length || !scope) return;

            const select = (id, focus = false) => {
              const selected = tabs.find((tab) => tab.dataset.marketingTab === id) || tabs[0];
              tabs.forEach((tab) => {
                const active = tab === selected;
                tab.setAttribute("aria-selected", String(active));
                tab.tabIndex = active ? 0 : -1;
              });
              panels.forEach((panel) => {
                panel.hidden = panel.id !== selected.getAttribute("aria-controls");
              });
              if (focus) selected.focus({preventScroll: true});
            };

            tabs.forEach((tab, index) => {
              tab.addEventListener("click", () => select(tab.dataset.marketingTab));
              tab.addEventListener("keydown", (event) => {
                let next = index;
                if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % tabs.length;
                if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + tabs.length) % tabs.length;
                if (event.key === "Home") next = 0;
                if (event.key === "End") next = tabs.length - 1;
                if (next !== index) {
                  event.preventDefault();
                  select(tabs[next].dataset.marketingTab, true);
                } else if (event.key === "Enter" || event.key === " ") {
                  event.preventDefault();
                  select(tab.dataset.marketingTab, true);
                }
              });
            });

            scope.querySelectorAll("[data-marketing-tab-trigger]").forEach((trigger) => {
              trigger.addEventListener("click", () => {
                select(trigger.dataset.marketingTabTrigger, true);
              });
              trigger.addEventListener("keydown", (event) => {
                if (event.key === "Enter" || event.key === " ") {
                  event.preventDefault();
                  select(trigger.dataset.marketingTabTrigger, true);
                }
              });
            });
          });
        };

        const mountTouchTooltips = () => {
          if (document.__alplusTouchTooltipsMounted) return;
          document.__alplusTouchTooltipsMounted = true;

          const tooltipFor = (point) => point.parentElement?.querySelector("[role='tooltip']");
          const hide = (except) => document.querySelectorAll("[data-touch-visible='true']").forEach((tooltip) => {
            if (tooltip === except) return;
            tooltip.classList.add("hidden");
            tooltip.dataset.touchVisible = "false";
            tooltip.setAttribute("aria-hidden", "true");
          });
          const show = (point) => {
            const tooltip = tooltipFor(point);
            if (!tooltip) return;
            hide(tooltip);
            tooltip.classList.remove("hidden");
            tooltip.dataset.touchVisible = "true";
            tooltip.setAttribute("aria-hidden", "false");
          };

          document.addEventListener("click", (event) => {
            const point = event.target instanceof Element
              ? event.target.closest("[data-display-point][data-touch-tooltip]")
              : null;
            if (point) return show(point);
            if (!(event.target instanceof Element) || !event.target.closest("[data-touch-tooltip]")) hide();
          });
          document.addEventListener("pointerdown", (event) => {
            if (!(event.target instanceof Element) || !event.target.closest("[data-touch-tooltip]")) hide();
          });
          document.addEventListener("focusin", (event) => {
            const point = event.target instanceof Element
              ? event.target.closest("[data-display-point][data-touch-tooltip]")
              : null;
            if (point) show(point);
          });
          document.addEventListener("focusout", (event) => {
            const point = event.target instanceof Element
              ? event.target.closest("[data-display-point][data-touch-tooltip]")
              : null;
            if (!point) return;
            requestAnimationFrame(() => {
              if (!point.closest("[data-touch-tooltip]")?.contains(document.activeElement)) hide();
            });
          });
        };

        document.addEventListener("DOMContentLoaded", () => {
          mountMarketingDisclosure();
          mountMarketingTabs();
          mountTouchTooltips();
        });
      })();
    </script>
  </head>
  <body class="bg-surface-page font-sans text-body text-text-primary antialiased">
    <a
      href="#main-content"
      class="sr-only z-50 bg-interactive-primary px-3 py-2 text-label text-interactive-ink focus:not-sr-only focus:fixed focus:left-2 focus:top-2"
    >
      Skip to main content
    </a>
    <div id="main-content" tabindex="-1">
      {@inner_content}
    </div>
  </body>
</html>
