# Disposable local-release values only. Replace every value for production.
PHX_SERVER=true
PHX_HOST=localhost
MCP_ALLOWED_ORIGINS=https://example.com
# Measure site token is public by design because it ships inside the served browser snippet.
# Put it in Kamal's env.clear, not Secrets Manager. Leave it unset to render no snippet at all.
# Get the value from the Measure site token in the dashboard.
MEASURE_SELF_TOKEN=
SECRET_KEY_BASE=8LmnvqvPON3paStmyu-kLytukGS_WGXFubueBypb63AzeIUiaMAosbJFsIg1TV70
TOKEN_SIGNING_SECRET=local-release-token-signing-secret
MEASURE_HASH_SECRET=local-release-measure-hash-secret
STRIPE_ENVIRONMENT=local
STRIPE_SECRET_KEY=sk_test_local_release_only
STRIPE_WEBHOOK_SECRET=whsec_local_release_only
STRIPE_PRICE_POSTDEPLOY_MONTHLY=price_local_postdeploy_monthly
OBSERVE_PAYLOADS_S3_BUCKET=alplus-observe-payloads
AWS_REGION=us-east-1
NOTIFICATIONS_VAULT_KEY=R3I5ZEJSLWFWdEY0TzdoaWpSeHV0Y1dKQUtxNURzWUNvWT0=
# Cloudflare Turnstile. The site key is public (rendered in the browser); this
# is the real PostDeploy widget. The secret is NOT public — set the real value from
# the Cloudflare dashboard (Turnstile → widget → secret) in the deploy env.
TURNSTILE_SITE_KEY=0x4AAAAAAEPMxlI8HUYJ7TT4
TURNSTILE_SECRET_KEY=set-the-real-secret-from-cloudflare
SIGNUPS_ENABLED=true
CLOUDFLARE_EMAIL_API_TOKEN=local-release-cloudflare-email-token
MAIL_FROM=noreply@localhost
# Local-only: the compose Postgres has no TLS. Production uses RDS TLS and must
# never set this.
DATABASE_SSL=false
